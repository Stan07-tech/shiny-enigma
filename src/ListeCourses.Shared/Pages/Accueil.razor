@page "/"
@page "/rayon/{Rayon}"
@inject ArticleService Service

@* Un composant Razor = du HTML + du C#. C'est l'équivalent d'une fenêtre
   WinDev : les champs (HTML) et le code des événements (@code plus bas).
   Cette page est partagée : le site web et l'appli Android l'affichent.
   Les deux directives @page lui donnent deux adresses : "/" (tous les
   articles) et "/rayon/Boulangerie" (un seul rayon). *@

<PageTitle>@(TitreVue is null ? "Liste de courses" : $"{TitreVue} – Liste de courses")</PageTitle>

<h1>🛒 @(TitreVue ?? "Liste de courses")</h1>

<form class="ajout" @onsubmit="Ajouter">
    <input class="nom-saisie" placeholder="Article (ex. : pain)" maxlength="100" autocomplete="off"
           @bind="nouvel.Nom" />
    <input class="quantite" type="number" min="1" aria-label="Quantité" @bind="nouvel.Quantite" />
    <input class="rayon-saisie" placeholder="Rayon" maxlength="50" @bind="nouvel.Rayon" />
    <button class="principal" type="submit">Ajouter</button>
</form>

@if (erreur is not null)
{
    <p class="erreur">@erreur</p>
}

@if (articles is null)
{
    <p class="vide">Chargement…</p>
}
else
{
    <nav class="rayons" aria-label="Rayons">
        <a href="" class="@(EstVueTous ? "actif" : null)">Tous</a>
        @foreach (var r in Rayons)
        {
            <a href="rayon/@Uri.EscapeDataString(r.Nom)" class="@(EstRayon(r.Nom) ? "actif" : null)">
                @r.Nom <span class="nb">@r.Restants</span>
            </a>
        }
        @if (articles.Any(a => a.Rayon is null))
        {
            <a href="sans-rayon" class="@(SansRayon ? "actif" : null)">Sans rayon</a>
        }
    </nav>

    <ul>
        @if (!Visibles.Any())
        {
            <li class="vide">@(articles.Count == 0 ? "La liste est vide." : "Aucun article dans ce rayon.")</li>
        }
        @foreach (var a in Visibles)
        {
            <li @key="a.Id" class="@(a.Achete ? "achete" : null)">
                <input type="checkbox" checked="@a.Achete" @onchange="() => Basculer(a.Id)" />
                <span class="nom">@a.Nom@(a.Quantite > 1 ? $" × {a.Quantite}" : "")</span>
                @if (EstVueTous)
                {
                    <span class="rayon">@a.Rayon</span>
                }
                <button class="suppr" title="Supprimer" @onclick="() => Supprimer(a.Id)">✕</button>
            </li>
        }
    </ul>

    <footer>
        <span>@Restants article@(Restants > 1 ? "s" : "") restant@(Restants > 1 ? "s" : "")</span>
        <button @onclick="ViderAchetes">Retirer les articles achetés</button>
    </footer>
}

@code {
    // Rempli automatiquement depuis l'adresse "/rayon/{Rayon}" (null sur "/").
    [Parameter] public string? Rayon { get; set; }

    // Vrai quand la page est affichée par SansRayon.razor ("/sans-rayon").
    [Parameter] public bool SansRayon { get; set; }

    private record RayonResume(string Nom, int Restants);

    private List<Article>? articles;
    private Article nouvel = new();
    private string? erreur;

    private bool EstVueTous => Rayon is null && !SansRayon;

    private string? TitreVue => SansRayon ? "Sans rayon" : Rayon;

    // Comparaison sans tenir compte des majuscules : "frais" et "Frais" = même rayon.
    private bool EstRayon(string? nom) =>
        string.Equals(nom, Rayon, StringComparison.CurrentCultureIgnoreCase);

    // Articles de la vue courante : l'équivalent d'un WHERE, mais en mémoire (LINQ to Objects).
    private IEnumerable<Article> Visibles =>
        SansRayon ? articles!.Where(a => a.Rayon is null)
        : Rayon is null ? articles!
        : articles!.Where(a => EstRayon(a.Rayon));

    // SELECT Rayon, SUM(CASE WHEN Achete = 0 THEN 1 ELSE 0 END) ... GROUP BY Rayon
    private IEnumerable<RayonResume> Rayons => articles!
        .Where(a => a.Rayon is not null)
        .GroupBy(a => a.Rayon!, StringComparer.CurrentCultureIgnoreCase)
        .Select(g => new RayonResume(g.Key, g.Count(a => !a.Achete)))
        .OrderBy(r => r.Nom, StringComparer.CurrentCultureIgnoreCase);

    private int Restants => articles is null ? 0 : Visibles.Count(a => !a.Achete);

    // Équivalent du code d'initialisation d'une fenêtre WinDev.
    protected override async Task OnInitializedAsync() => await Charger();

    // Appelé à chaque changement d'adresse (passage d'un rayon à l'autre) :
    // le rayon courant est proposé par défaut pour le prochain article.
    protected override void OnParametersSet()
    {
        nouvel = new() { Rayon = Rayon };
        erreur = null;
    }

    private async Task Charger() => articles = await Service.ListerAsync();

    private async Task Ajouter()
    {
        if (await Service.AjouterAsync(nouvel) is null)
        {
            erreur = "Le nom est obligatoire.";
            return;
        }

        erreur = null;
        nouvel = new() { Rayon = Rayon };
        await Charger();
    }

    private async Task Basculer(int id)
    {
        await Service.BasculerAsync(id);
        await Charger();
    }

    private async Task Supprimer(int id)
    {
        await Service.SupprimerAsync(id);
        await Charger();
    }

    // Ne retire que les articles achetés de la vue courante (tous, ou ce rayon).
    private async Task ViderAchetes()
    {
        if (EstVueTous)
        {
            await Service.SupprimerAchetesAsync();
        }
        else
        {
            foreach (var a in Visibles.Where(a => a.Achete).ToList())
                await Service.SupprimerAsync(a.Id);
        }

        await Charger();
    }
}
